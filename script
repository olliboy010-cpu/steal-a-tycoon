--// Core Variables
local antiStealMode = "Kick"
local antiStealEnabled = false
local baseConnection = nil
local treatFriendsAsSafe = true
local blacklist = {}

--// Teleport Functions
local function TeleportForward()
    local char = player.Character or player.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = hrp.CFrame + hrp.CFrame.LookVector * 6
    end
end

local function FindMyBase()
    for i = 1, 8 do
        local base = workspace:FindFirstChild("tycoonBaseplate"..i)
        if base and base:FindFirstChild("Owner") and base.Owner:IsA("StringValue") and base.Owner.Value == player.Name then
            return base
        end
    end
    return nil
end

local function TeleportBase()
    local char = player.Character or player.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local myBase = FindMyBase()
    if myBase then
        hrp.CFrame = myBase.CFrame + Vector3.new(0, 5, 0)
    else
        warn("No owned base found!")
    end
end

--// Anti-Steal Functions
local function PerformAntiSteal()
    if antiStealMode == "Kick" then
        player:Kick("Anti-Steal: Someone entered your base.")
    elseif antiStealMode == "Server Hop" then
        local success, servers = pcall(function()
            return HttpService:JSONDecode(
                game:HttpGet("https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100")
            )
        end)
        if success and servers and servers.data then
            for _, srv in ipairs(servers.data) do
                if srv.playing < srv.maxPlayers then
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, srv.id, player)
                    break
                end
            end
        end
    end
end

local function IsEnemy(plr)
    if plr == player then return false end
    if blacklist[plr.Name] then return true end
    local ok, isFriend = pcall(function() return player:IsFriendsWith(plr.UserId) end)
    if treatFriendsAsSafe then
        return not (ok and isFriend)
    else
        return true
    end
end

local function EnableAntiSteal(state)
    antiStealEnabled = state
    if baseConnection then baseConnection:Disconnect() baseConnection = nil end
    if not state then return end
    local myBase = FindMyBase()
    if not myBase then warn("Anti-Steal enabled but no base found!") return end
    baseConnection = myBase.Touched:Connect(function(hit)
        local char = hit:FindFirstAncestorWhichIsA("Model")
        local plr = char and Players:GetPlayerFromCharacter(char)
        if plr and IsEnemy(plr) then
            PerformAntiSteal()
        end
    end)
end

--// Highlights / ESP
local highlights = {}
local espConnection

local function ApplyHighlight(plr)
    if plr.Character and not highlights[plr] and IsEnemy(plr) then
        local h = Instance.new("Highlight")
        h.Name = "ESP_Highlight"
        h.Adornee = plr.Character
        h.FillColor = Color3.fromRGB(255, 0, 0)
        h.OutlineColor = Color3.fromRGB(255, 255, 255)
        h.Parent = plr.Character
        highlights[plr] = h
    end
end

local function RemoveHighlight(plr)
    if highlights[plr] then
        highlights[plr]:Destroy()
        highlights[plr] = nil
    end
end

local function ToggleHighlights(state)
    -- cleanup
    for _, h in pairs(highlights) do if h then h:Destroy() end end
    highlights = {}
    if espConnection then espConnection:Disconnect() espConnection = nil end

    if state then
        for _, plr in ipairs(Players:GetPlayers()) do
            ApplyHighlight(plr)
            plr.CharacterAdded:Connect(function()
                task.wait(0.5)
                ApplyHighlight(plr)
            end)
        end
        espConnection = Players.PlayerAdded:Connect(function(plr)
            plr.CharacterAdded:Connect(function()
                task.wait(0.5)
                ApplyHighlight(plr)
            end)
        end)
    end
end

